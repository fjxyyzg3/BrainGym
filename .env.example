# 本地/开发使用同一 origin，不能带路径或尾斜杠。
APP_ORIGIN=http://127.0.0.1:3000
# 普通启动默认 /；WheelMaker 定义使用 /braingym/，无需重新构建前端。
APP_BASE_PATH=/
# 普通运行默认 3000；WheelMaker 定义使用 3001。
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/braingym.sqlite
# 线上 HTTPS 必须改为 true，并将 APP_ORIGIN 改为对应 HTTPS origin。
COOKIE_SECURE=false
# WheelMaker 托管定义还设置以下两项；普通运行无需配置。
# 配置脚本与公网验收脚本要求私有 HTTPS APP_ORIGIN，不使用上方开发值。
# WHEELMAKER_STATE_DIR=C:/Users/<user>/.wheelmaker
# WHEELMAKER_SERVICE_ID=braingym
