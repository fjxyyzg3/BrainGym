# 开发可复制为 .env.development.local；开发 API 与 Vite 共用这些端口。
DEV_API_PORT=3002
DEV_WEB_PORT=5173
# 开发库只能放在当前工作区 .runtime/development 内。
# DATABASE_PATH=.runtime/development/braingym.sqlite
# 开发命令固定 BRAINGYM_ENV=development，回环 HOST、Origin、Cookie 随入口配置。

# 正式运行设置由现有私有 Hub 定义提供，不复制开发配置到正式。
# BRAINGYM_ENV=production
# HOST=127.0.0.1
# PORT=3001
# APP_BASE_PATH=/braingym/
# APP_ORIGIN=https://apps.example.com
# COOKIE_SECURE=true
# DATABASE_PATH=<现有正式数据库绝对路径>
# WHEELMAKER_SERVICE_ID=braingym

# 主仓库 .env.production.local 仅供发布和正式管理入口读取。
# 自定义 Hub 时设置 WHEELMAKER_STATE_DIR；控制认证使用已有 Registry 登录 Token。
# WHEELMAKER_STATE_DIR=C:/Users/<user>/.wheelmaker
# BRAINGYM_REGISTRY_TOKEN=<existing-registry-login-token>
# 正式 CLI 只需要本地定义，发布控制才需要 Registry 认证。
# Docker Compose 的 .env 配置仍使用 APP_ORIGIN、COOKIE_SECURE 和宿主 PORT。
